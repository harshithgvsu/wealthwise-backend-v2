# Copy this file to .env and fill in your values
# NEVER commit .env to git

# MongoDB Atlas connection string
# Get this from Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://abc

# JWT secret — generate a strong random string, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=1234578968085-1840798ih

# JWT expiry
JWT_EXPIRES_IN=90d

# Port
PORT=3001

# Frontend origin for CORS — your GitHub Pages URL
# During local dev you can add http://localhost:5173 here too (comma-separated)
CORS_ORIGIN=https://harshithgvsu.github.io

# Anthropic API key for AI chat and expense parsing
# Get from https://console.anthropic.com — leave blank to disable AI (app falls back to local logic)
ANTHROPIC_API_KEY=

# ── Ollama (local LLM — takes priority over Anthropic if reachable) ────────────
# Run: ollama serve  (default http://localhost:11434)
# Pull a model: ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Plaid (bank + investment account linking) ──────────────────────────────────
# Sign up free at https://dashboard.plaid.com/signup
# Use PLAID_ENV=sandbox for development (free, uses test credentials)
# Sandbox test: username=user_good  password=pass_good
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
